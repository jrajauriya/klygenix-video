# Klygenix Play — US host (V5.4). Same compose file as India (docker-compose.prod.yml) on its own VPS with its own
# Postgres, Redis, Bunny library (US replication) and Lemon Squeezy as the only rail (no Razorpay, no creator Route money).
# Accounts are pinned to their home region (country → region); with REGION_ENFORCE the other host refuses them with a link.
REGION=us
REGION_ENFORCE=true
REGION_URLS=in=https://api.play.klygenix.com,us=https://api.us.play.klygenix.com
REGION_US_COUNTRIES=US,CA
PUBLIC_DOMAIN=us.play.klygenix.com

# Klygenix Play — production. Lives on the VPS only; never committed.
# Every setting below has a default in app/config.py; this file is the complete list,
# so nothing is configurable-but-undiscoverable. docs/LAUNCH.md says where each value comes from.
# Check it before every deploy:  backend/venv/bin/python -m app.readiness --env-file backend/.env.prod
# Secrets may be written as enc:... (python3 scripts/manage_secrets.py encrypt) and are unsealed
# with backend/.secret.key.

DATABASE_URL=postgresql://klygenix_video:CHANGE_ME@postgres:5432/klygenix_video
# The application connects as a restricted role: RLS does not apply to an owner,
# and kv_ledger revokes UPDATE/DELETE from this role. The first migration creates it with a
# password equal to its name — ALTER ROLE it (docs/LAUNCH.md step 5) before using this URL.
APP_DATABASE_URL=postgresql://klygenix_video_app:CHANGE_ME@postgres:5432/klygenix_video
SECRET_KEY=CHANGE_ME_python_c_import_secrets_print_secrets_token_urlsafe_64
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
BUYER_TOKEN_EXPIRE_MINUTES=43200

# Platform owner — seeded on first boot
GLOBAL_ADMIN_EMAIL=admin@klygenix.com
GLOBAL_ADMIN_PASSWORD=CHANGE_ME_strong_password
GLOBAL_ADMIN_NAME=Global Admin

ADMIN_TENANT_SLUG=klygenix-video-admin
ADMIN_TENANT_NAME=Klygenix Technologies Private Limited
ADMIN_STORE_HANDLE=klygenix

APP_LOGIN_URL=https://admin.us.play.klygenix.com/login
STUDIO_APP_URL=https://studio.us.play.klygenix.com
STOREFRONT_BASE_URL=https://us.play.klygenix.com
LIBRARY_BASE_URL=https://us.play.klygenix.com/library
API_PUBLIC_BASE_URL=https://api.us.play.klygenix.com
WEB_BASE_URL=https://us.play.klygenix.com

# The admin console and the studio call the API cross-origin; the storefront and library use /api on their own host.
CORS_ORIGINS=https://admin.us.play.klygenix.com,https://studio.us.play.klygenix.com,https://us.play.klygenix.com,https://tv.us.play.klygenix.com

REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379/0
JOBS_MODE=rq

# Payments — Razorpay live keys for Klygenix's own store, plan billing, Route and RazorpayX.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_RAIL=lemonsqueezy
# Route (creator payouts): Razorpay's business category for Play — confirm with Razorpay; empty refuses Route.
ROUTE_PROFILE_CATEGORY=
ROUTE_PROFILE_SUBCATEGORY=
# Merchant of record abroad (USD). Webhook: https://api.<PUBLIC_DOMAIN>/api/video/webhooks/payments/lemonsqueezy
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
MARKETPLACE_RESERVE_BPS=500
MARKETPLACE_RESERVE_DAYS=30
# Must be false in production: no sandbox Pay button, no loopback rate-limit exemption, no open /metrics.
SANDBOX_ENABLED=false
# false while only Klygenix sells; true when creators may open their own stores.
SIGNUP_ENABLED=false

# Creators' custom domains (Cloudflare for SaaS). Empty = DNS checks only.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CUSTOM_DOMAIN_TARGET=domains.us.play.klygenix.com
IMPERSONATION_MINUTES=60

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email leaves as contact@klygenix.com (a Microsoft 365 shared mailbox) through Microsoft Graph, app-only: an Entra
# app with "Application Mail.Send" scoped to that mailbox (RBAC for Applications). A row saved in Admin → Email Config
# wins; with MS_GRAPH_* empty, the SMTP_* account below is used. Seal the secret as enc:...
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER=contact@klygenix.com
# YYYY-MM-DD; readiness warns 30 days before the client secret expires
MS_GRAPH_SECRET_EXPIRES=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=klygenix@gmail.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=contact@klygenix.com
SMTP_FROM_NAME=Klygenix Play

# Object storage — product files, invoices, certificates. Private bucket; signed URLs only.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1
DOWNLOAD_URL_TTL_SECONDS=300

# Video hosting (V01): Bunny Stream. Webhook: https://api.<PUBLIC_DOMAIN>/api/video/webhooks/media/bunny?secret=<BUNNY_WEBHOOK_SECRET>
# BUNNY_TOKEN_KEY turns on token-signed playback (required for paid and members-only videos).
VIDEO_PROVIDER=bunny
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOST=
BUNNY_TOKEN_KEY=
BUNNY_WEBHOOK_SECRET=

# Language model (Azure OpenAI Responses API) and embeddings. Costs feed the monthly budget gate (minor units, INR).
LLM_PROVIDER=azure
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MODEL_FAST=
LLM_MONTHLY_BUDGET_MINOR=500000
LLM_INPUT_COST_PER_MTOK_MINOR=0
LLM_OUTPUT_COST_PER_MTOK_MINOR=0
EMBED_PROVIDER=azure
EMBED_URL=
EMBED_MODEL=text-embedding-3-small

# Speech to text: azure_speech (fast transcription) or openai (Whisper deployment).
STT_PROVIDER=azure_speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
STT_COST_PER_MIN_MINOR=0

# Text to speech for consented AI dubbing.
TTS_PROVIDER=azure
AZURE_TTS_KEY=
AZURE_TTS_REGION=eastus

# Safety scan vendor (V08). Until it is live keep creator sign-up on invite (SIGNUP_MODE / CREATOR_SIGNUP).
SCAN_PROVIDER=
SCAN_API_URL=
SCAN_API_KEY=

# YouTube connect + Shorts upload (Google OAuth app, verified consent screen).
YOUTUBE_PROVIDER=live
YOUTUBE_OAUTH_REDIRECT=https://api.<PUBLIC_DOMAIN>/api/video/channels/youtube/callback
PUBLISH_PROVIDER=live

# Product mail (waitlist, invites, notices): graph (Microsoft Graph, MS_GRAPH_*) or smtp; sandbox only captures to the outbox.
EMAIL_PROVIDER=graph

# Closed beta: SIGNUP_MODE open | invite | closed; CREATOR_SIGNUP open | invite | closed (keep invite until the scan vendor is live).
SIGNUP_MODE=invite
CREATOR_SIGNUP=invite

ACTIVITY_LOG_RETENTION_DAYS=90
LOG_LEVEL=INFO

# Prometheus scrape token (infra/METRICS.md). Empty disables /metrics in production.
METRICS_TOKEN=

# Error tracking (Sentry protocol: sentry.io or a self-hosted GlitchTip). Empty = off.
# SENTRY_RELEASE is baked into the image at build (infra/deploy.sh passes the git sha); leave it unset here.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
# Public-write rate limits (per IP unless noted); defaults suit launch. RATE_LIMITS_ENABLED=false turns them off.
RATE_LIMITS_ENABLED=true
RATE_LIMIT_EXEMPT_IPS=127.0.0.1,::1

STOREFRONT_INDEX_PATH=/app/storefront/index.html

# Live (V4). Production uses Cloudflare Stream Live; the sandbox ingest (compose profile sandbox-live) is for staging only.
LIVE_PROVIDER=cloudflare
LIVE_WORKER_INLINE=false
CF_ACCOUNT_ID=
CF_STREAM_TOKEN=
CF_STREAM_CUSTOMER_HOST=
# Signing key from POST /stream/keys (id + the base64 "pem"); webhook secret from PUT /stream/webhook;
# CF_NOTIFY_SECRET is the secret on the Notifications webhook destination for "Stream Live Input" events.
# Both post to https://api.<PUBLIC_DOMAIN>/api/video/webhooks/cloudflare-live
CF_STREAM_SIGNING_KEY_ID=
CF_STREAM_SIGNING_KEY=
CF_STREAM_WEBHOOK_SECRET=
CF_NOTIFY_SECRET=

# Push notifications through Expo (push credentials for APNs/FCM live in EAS, not here).
PUSH_PROVIDER=expo
EXPO_ACCESS_TOKEN=

# Instagram API with Instagram Login (needs Meta app review for instagram_business_content_publish).
INSTAGRAM_PROVIDER=live
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
