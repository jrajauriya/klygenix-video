{
  "expo": {
    "name": "Klygenix Play",
    "slug": "klygenix-play",
    "scheme": "klygenixplay",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.klygenix.play"
    },
    "android": {
      "package": "com.klygenix.play"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Record a vertical video for your channel",
          "microphonePermission": "Record sound with your video",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#A21CAF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick a video from your library to upload",
          "cameraPermission": "Record a vertical video for your channel",
          "microphonePermission": "Record sound with your video"
        }
      ],
      "expo-status-bar",
      "expo-video"
    ],
    "extra": {
      "apiUrl": "http://localhost:9300",
      "webUrl": "http://localhost:5300"
    }
  }
}
