# Dependencies
node_modules/
.turbo/

# Build
dist/
build/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local
backend/.env.prod
infra/.env
infra/.env.staging
infra/.env.staging-us

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
venv/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.claude/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Docker
docker-compose.override.yml

# SSL certificates — origin certs live on the VPS only
infra/nginx/ssl/

# Logs
*.log
npm-debug.log*

# Uploads and secrets — customer files never belong in the repository
backend/uploads/*
!backend/uploads/.gitkeep
private_uploads/
backend/.secret.key

# Database backups — never commit
db-backup/

# Coverage
coverage/
htmlcov/
.coverage

# Expo
apps/mobile/.expo/
.expo-shared/

# Native projects are generated by `expo prebuild` — the managed workflow owns them
apps/mobile/ios/
apps/mobile/android/

# Store signing and push credentials
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
*.cer
google-services.json
GoogleService-Info.plist

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Database dumps
*.dump
*.sql.gz
*.sqlite
*.sqlite3
dist-e2e/

# Dev-only web push key, generated on first start
backend/.vapid-dev.pem

# Security scan output (infra/security/zap.sh) — local evidence, never uploaded
infra/security/reports/
