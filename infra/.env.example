# Docker Compose variables for production (infra/.env). Never committed.
POSTGRES_USER=klygenix_video
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=klygenix_video

REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379/0

# App links (nginx serves /.well-known/apple-app-site-association and assetlinks.json; empty = 404).
# Apple Team ID (10 characters) and the Play app signing key's SHA-256 fingerprint(s), comma-separated.
APPLE_TEAM_ID=
ANDROID_CERT_SHA256=
